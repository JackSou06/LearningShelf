    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "O_APPEND 下連續 write(\"A\")、write(\"B\")，可以保證沒有別人的資料插在兩者間嗎？",
      "options": [
        {
          "id": "option-0",
          "text": "可以，因為有 O_APPEND"
        },
        {
          "id": "option-1",
          "text": "不可以，兩次呼叫間仍可交錯"
        },
        {
          "id": "option-2",
          "text": "只要使用同一 fd 就可以"
        }
      ],
      "answerId": "option-1",
      "explanation": "Append 的單次定位與寫入保證，不會把兩個 system calls 包成一個交易。",
      "revisit": "append"
    }
  ]
