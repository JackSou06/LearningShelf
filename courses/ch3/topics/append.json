    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "O_RDWR | O_APPEND 開啟後 lseek 到 0，再 write，寫在哪？",
      "options": [
        {
          "id": "option-0",
          "text": "開頭，因為剛剛 seek 到 0"
        },
        {
          "id": "option-1",
          "text": "該次 write 時的 EOF"
        },
        {
          "id": "option-2",
          "text": "一律失敗"
        }
      ],
      "answerId": "option-1",
      "explanation": "O_APPEND 作用在每次 write 的定位，會使用當時 EOF；read 則仍可由目前位置讀取。"
    }
  ]
