      "initialState": true,
      "steps": [
        {
          "id": "initial",
          "title": "初始狀態",
          "bodyMarkdown": "圖中省略未涉及的 fd；∅ 表示 EOF。",
          "snapshot": {
            "processes": {
              "P": {}
            },
            "entries": {},
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-1",
          "title": "步驟 1",
          "code": "fd1 = open(\"foobar.txt\", O_RDONLY);",
          "bodyMarkdown": "配置 fd 3，建立 entry A，offset 從 0 開始。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-2",
          "title": "步驟 2",
          "code": "fd2 = dup(fd1);",
          "bodyMarkdown": "配置 fd 4，連到既有的 A。A 現在被兩個 fd 參考。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-3",
          "title": "步驟 3",
          "code": "read(fd1, &c, 1);",
          "bodyMarkdown": "由 fd1 指向的 A 讀取 f；A 的 offset 前進到 1。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-4",
          "title": "步驟 4",
          "code": "read(fd2, &c, 1);",
          "bodyMarkdown": "fd2 同樣使用 A。從 offset 1 讀到 o，A 前進到 2。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 2,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "o"
          }
        }
      ]
    },
