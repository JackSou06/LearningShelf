    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "open 後 dup，先由 fd1 讀一 byte，再由 fd2 讀一 byte，第二次得到？",
      "options": [
        {
          "id": "option-0",
          "text": "f"
        },
        {
          "id": "option-1",
          "text": "o"
        },
        {
          "id": "option-2",
          "text": "仍是 EOF"
        }
      ],
      "answerId": "option-1",
      "explanation": "兩個 fd 共用 A；第一個 read 把 A 的 offset 變 1，第二個便讀 o。",
      "revisit": "two-opens"
    }
  ]
