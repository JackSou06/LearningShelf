            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-2",
          "title": "步驟 2",
          "code": "fd2 = open(\"foobar.txt\", O_RDONLY);",
          "bodyMarkdown": "第二次 open 建立獨立 entry B；兩個 entry 指向同一檔案。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "B"
              }
            },
            "entries": {
