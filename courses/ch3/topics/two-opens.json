      "id": "quiz-0",
      "type": "singleChoice",
      "question": "兩次 open 後，分別 read(fd1,1)、read(fd2,1)，第二次得到？",
      "options": [
        {
          "id": "option-0",
          "text": "f"
        },
        {
          "id": "option-1",
          "text": "o"
        },
        {
          "id": "option-2",
          "text": "b"
        }
      ],
      "answerId": "option-0",
      "explanation": "fd1 推進 A 的 offset，不會推進 B；fd2 仍從位置 0 讀 f。",
