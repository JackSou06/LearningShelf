                "flags": "O_RDONLY",
                "refs": 1
              },
              "B": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-3",
          "title": "步驟 3",
          "code": "read(fd1, &c, 1);",
          "bodyMarkdown": "由 fd1 指向的 A 讀取 f；A 的 offset 前進到 1。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "B"
              }
            },
            "entries": {
              "A": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              },
              "B": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-4",
          "title": "步驟 4",
          "code": "read(fd2, &c, 1);",
          "bodyMarkdown": "B 的 offset 仍是 0，因此又讀到 f。A、B 最後各停在 1。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "B"
              }
