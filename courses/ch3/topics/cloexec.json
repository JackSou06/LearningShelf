      "id": "quiz-0",
      "type": "singleChoice",
      "question": "fd1 設了 FD_CLOEXEC，fd2=dup(fd1) 成功後，新 fd2 的該旗標？",
      "options": [
        {
          "id": "option-0",
          "text": "自動跟 fd1 共用"
        },
        {
          "id": "option-1",
          "text": "通常被清除，屬於自己的 descriptor flags"
        },
        {
          "id": "option-2",
          "text": "fork 前才會有這個旗標"
        }
      ],
      "answerId": "option-1",
      "explanation": "Dup 共用 file status flags，但新 descriptor 的 close-on-exec 會清除。",
      "revisit": "flags-scope"
    }
