    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "dup2(fd2, fd1) 成功後，哪個說法正確？",
      "options": [
        {
          "id": "option-0",
          "text": "fd2 改指向 fd1 原來的 entry"
        },
        {
          "id": "option-1",
          "text": "fd1 改指向 fd2 的 entry"
        },
        {
          "id": "option-2",
          "text": "兩個 fd 都回到 offset 0"
        }
      ],
      "answerId": "option-1",
      "explanation": "方向是「後面的 fd 指向前面的開啟狀態」；不會重設該 entry 的 offset。"
    }
  ]
