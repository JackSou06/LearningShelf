        {
          "id": "initial",
          "title": "初始狀態",
          "bodyMarkdown": "圖中省略未涉及的 fd；∅ 表示 EOF。",
          "snapshot": {
            "processes": {
              "P": {}
            },
            "entries": {},
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-1",
          "title": "步驟 1",
          "code": "fd1 = open(\"foobar.txt\", O_RDONLY);",
          "bodyMarkdown": "配置 fd 3，建立 entry A，offset 從 0 開始。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-2",
          "title": "步驟 2",
          "code": "fd2 = open(\"foobar.txt\", O_RDONLY);",
          "bodyMarkdown": "建立 B，與 A 使用不同 offset。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "B"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              },
              "B": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-3",
          "title": "步驟 3",
          "code": "read(fd2, &c, 1);",
          "bodyMarkdown": "B 讀到 f，offset 變 1；A 仍在 0。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A",
                "4": "B"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              },
              "B": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-4",
          "title": "步驟 4",
          "code": "dup2(fd2, fd1);",
          "bodyMarkdown": "fd1 改指向 B。A 沒有剩餘參考而釋放；B 的 offset 仍是 1。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "B",
                "4": "B"
              }
            },
            "entries": {
              "B": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-5",
          "title": "步驟 5",
          "code": "read(fd1, &c, 1);",
          "bodyMarkdown": "現在 fd1 使用 B，讀到 o；B 的 offset 變 2。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "B",
                "4": "B"
              }
            },
            "entries": {
              "B": {
                "offset": 2,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "o"
          }
        }
      ]
