    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "要保留其他位元，只清掉 O_APPEND，哪個式子正確？",
      "options": [
        {
          "id": "option-0",
          "text": "val = ~O_APPEND"
        },
        {
          "id": "option-1",
          "text": "val &= ~O_APPEND"
        },
        {
          "id": "option-2",
          "text": "val |= ~O_APPEND"
        }
      ],
      "answerId": "option-1",
      "explanation": "AND 上反向遮罩，只會把 O_APPEND 對應的位元清為 0。"
    },
