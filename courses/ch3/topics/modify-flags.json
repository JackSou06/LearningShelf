      "language": "c",
      "code": "int val = fcntl(fd, F_GETFL);\nif (val == -1) { /* 處理錯誤 */ }\nelse {\n    val |= O_APPEND;\n    if (fcntl(fd, F_SETFL, val) == -1) {\n        /* 處理錯誤 */\n    }\n}"
