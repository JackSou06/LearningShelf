          }
        },
        {
          "id": "step-4",
          "title": "步驟 4",
          "code": "write(STDOUT_FILENO, \"Hi\", 2);",
          "bodyMarkdown": "寫入 out.txt：內容成為 Hi，offset 與 size 都變成 2。",
