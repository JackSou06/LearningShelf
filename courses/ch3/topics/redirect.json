            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-3",
          "title": "步驟 3",
          "code": "close(fd);",
          "bodyMarkdown": "關閉 fd 3；fd 1 仍參考 A，所以 A 保留。",
          "snapshot": {
            "processes": {
              "P": {
                "1": "A"
