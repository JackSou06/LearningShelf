        {
          "id": "step-1",
          "title": "步驟 1",
          "code": "fd = open(\"out.txt\", O_WRONLY | O_CREAT | O_TRUNC, 0644);",
          "bodyMarkdown": "假設回傳 fd 3，建立對應 out.txt 的 A。",
          "snapshot": {
            "processes": {
              "P": {
                "1": "T",
