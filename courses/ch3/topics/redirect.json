            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-2",
          "title": "步驟 2",
          "code": "dup2(fd, STDOUT_FILENO);",
          "bodyMarkdown": "fd 1 改指向 A，後續經由 stdout 的輸出走向 out.txt。",
          "snapshot": {
            "processes": {
              "P": {
                "1": "A",
