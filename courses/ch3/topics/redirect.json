    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "假設 fd=3，dup2(fd,1) 成功後 close(fd)，stdout？",
      "options": [
        {
          "id": "option-0",
          "text": "因為 fd 被關閉，所以不能輸出"
        },
        {
          "id": "option-1",
          "text": "仍透過 fd 1 指向檔案"
        },
        {
          "id": "option-2",
          "text": "恢復指向 terminal"
        }
      ],
      "answerId": "option-1",
      "explanation": "fd 1 的參考仍存在，close(3) 不會撤銷 dup2 已建立的連結。",
      "revisit": "close"
    }
  ]
