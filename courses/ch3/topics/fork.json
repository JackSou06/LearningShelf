      "id": "lab",
      "type": "steps",
      "presentation": "program",
      "initialState": true,
      "steps": [
        {
          "id": "initial",
          "title": "初始狀態",
          "bodyMarkdown": "圖中省略未涉及的 fd；∅ 表示 EOF。",
          "snapshot": {
            "processes": {
              "P": {}
            },
            "entries": {},
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-1",
          "title": "步驟 1",
          "code": "fd1 = open(\"foobar.txt\", O_RDONLY);",
          "bodyMarkdown": "配置 fd 3，建立 entry A，offset 從 0 開始。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-2",
          "title": "步驟 2",
          "code": "pid = fork();",
          "bodyMarkdown": "新增 child 的 fd table；繼承的 fd 3 仍指向 A。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              },
              "Child": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 0,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "尚未讀寫"
          }
        },
        {
          "id": "step-3",
          "title": "步驟 3",
          "code": "/* child */ read(fd1, &c, 1);",
          "bodyMarkdown": "child 先讀到 f；共享 entry A 的 offset 變成 1。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              },
              "Child": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 2
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-4",
          "title": "步驟 4",
          "code": "/* child */ _exit(0);",
          "bodyMarkdown": "child 結束，關閉它的 fd；parent 仍保有 A 的參考。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-5",
          "title": "步驟 5",
          "code": "/* parent */ wait(NULL);",
          "bodyMarkdown": "parent 確認 child 已結束；wait 本身不重設 offset。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 1,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "f"
          }
        },
        {
          "id": "step-6",
          "title": "步驟 6",
          "code": "/* parent */ read(fd1, &c, 1);",
          "bodyMarkdown": "parent 沿著 A 從 offset 1 讀到 o。",
          "snapshot": {
            "processes": {
              "P": {
                "3": "A"
              }
            },
            "entries": {
              "A": {
                "offset": 2,
                "file": "foobar.txt",
                "flags": "O_RDONLY",
                "refs": 1
              }
            },
            "files": {
              "foobar.txt": "foobar"
            },
            "output": "o"
          }
        }
      ]
    },
