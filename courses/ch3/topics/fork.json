    {
      "id": "quiz-0",
      "type": "singleChoice",
      "question": "child 讀一 byte 並結束，parent wait 完再讀，parent 得到？",
      "options": [
        {
          "id": "option-0",
          "text": "f，因為是不同 process"
        },
        {
          "id": "option-1",
          "text": "o，因為共享 entry 的 offset"
        },
        {
          "id": "option-2",
          "text": "一定是 EOF"
        }
      ],
      "answerId": "option-1",
      "explanation": "不同 process 不代表不同開啟狀態；繼承的 fd 仍指向同一個 entry。",
      "revisit": "three-tables"
    }
  ]
}