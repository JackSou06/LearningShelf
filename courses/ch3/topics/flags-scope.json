      "id": "quiz-0",
      "type": "singleChoice",
      "question": "透過 fd1 的 F_SETFL 成功開啟 O_APPEND，哪些 fd 共用這個變更？",
      "options": [
        {
          "id": "option-0",
          "text": "只有 fd1"
        },
        {
          "id": "option-1",
          "text": "fd1 和 fd2"
        },
        {
          "id": "option-2",
          "text": "fd1、fd2、fd3"
        }
      ],
      "answerId": "option-1",
      "explanation": "Status flags 在 A；fd1、fd2 指向 A。fd3 指向獨立的 B。",
      "revisit": "three-tables"
    }
